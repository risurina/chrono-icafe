# ─────────────────────────────────────────────────────────────
# apps/web — copy to apps/web/.env and fill in. Never commit .env.
# Next.js loads this automatically. Only NEXT_PUBLIC_* vars are client-visible.
# ─────────────────────────────────────────────────────────────

# Apex domain tenants live under; subdomains become tenant slugs. Used by the
# tenant middleware and the browser tenant/customer clients.
NEXT_PUBLIC_APP_DOMAIN="localtest.me:3000"

# API origin. MUST share the registrable domain with the tenant subdomains so
# the session cookie is shared — locally api.localtest.me.
NEXT_PUBLIC_API_URL="http://api.localtest.me:8787"

# ─── Error tracking (Sentry) ──────────────────────────────────────
# Client-visible DSN — unset → fully inert (Sentry.init with no dsn is a no-op).
# NEXT_PUBLIC_SENTRY_DSN="https://xxxx@oNNNNNN.ingest.us.sentry.io/NNNNNNN"
# NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"
# Optional: only needed to upload source maps at build time.
# SENTRY_ORG="my-org"
# SENTRY_PROJECT="my-project"
# SENTRY_AUTH_TOKEN="sntrys_xxxxxxxxxxxxxxxxxxxx"
