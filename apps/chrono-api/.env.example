# ─────────────────────────────────────────────────────────────
# apps/api — copy to apps/api/.env and fill in. Never commit .env.
# Loaded via dotenv (cwd is apps/api when Turbo/pnpm runs this app).
# The DB scripts (db:push / db:migrate / db:seed / rls:proof) also read this.
# ─────────────────────────────────────────────────────────────

# Neon Postgres — the APP connection. Use the *pooled* connection string.
#
# ⚠ This MUST connect as a restricted role with NOBYPASSRLS that does NOT own the
# tables. `FORCE ROW LEVEL SECURITY` only removes the table owner's implicit
# exemption — it cannot override a role's BYPASSRLS attribute. Neon's default
# `neondb_owner` has BYPASSRLS, so pointing DATABASE_URL at it silently disables
# every tenant policy while the schema still looks correct, and `pnpm typecheck`
# will not catch it. Provision the role once:
#
#   APP_DB_PASSWORD="$(openssl rand -base64 32)" \
#     pnpm --filter @agora/api db:app-role
#
# then set DATABASE_URL to that role (same host/database, new credentials) and
# confirm with `pnpm --filter @agora/api rls:proof` → RLS PROOF: PASS ✅.
DATABASE_URL="postgres://agora_app:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/agora?sslmode=require"

# The ADMIN/owner connection: migrations, RLS application, role provisioning, and
# the framework's explicit withAdmin() cross-tenant reads (custom-domain lookup,
# seeding, webhook sync). This is where the owner role (e.g. neondb_owner) goes.
# Required whenever DATABASE_URL is the restricted role above.
DATABASE_URL_ADMIN="postgres://neondb_owner:PASSWORD@ep-xxxx.REGION.aws.neon.tech/agora?sslmode=require"

# Optional: Credit grant expiry sweep interval in milliseconds (defaults to 300000 / 5 minutes)
CREDIT_EXPIRY_SWEEP_INTERVAL_MS=300000

# Optional: app-usage (per-station app/game telemetry) retention + stale-run
# sweep tuning — see .ai/plans/chrono/in-progress/app-usage/README.md.
#   APP_USAGE_RETENTION_DAYS        how long a row survives before the prune
#                                    sweep hard-deletes it (default 90)
#   APP_USAGE_STALE_DEVICE_MINUTES  how long a device may go unheard-from
#                                    (no heartbeat) before its open runs are
#                                    force-closed, so a crashed/reimaged kiosk
#                                    doesn't leave a permanent zombie row in
#                                    "Currently Running" (default 15)
#   APP_USAGE_SWEEP_INTERVAL_MS     how often both sweeps run, on one
#                                    setInterval (default 300000 / 5 minutes)
APP_USAGE_RETENTION_DAYS=90
APP_USAGE_STALE_DEVICE_MINUTES=15
APP_USAGE_SWEEP_INTERVAL_MS=300000

# Role name + password used by `pnpm --filter @agora/api db:app-role` to create or
# refresh the restricted app role. Only needed when running that command.
# APP_DB_ROLE="agora_app"
# APP_DB_PASSWORD="generate-with-openssl-rand-base64-32"

# OPTIONAL test database for `pnpm test:e2e`. When set, the e2e DROPS ALL TABLES
# on it, migrates, seeds, then runs — so point it at a DEDICATED test database
# (a separate Neon branch is ideal). Must differ from DATABASE_URL and its name
# must contain "test" (or set E2E_ALLOW_DESTRUCTIVE=1). Leave unset to run the
# e2e against an in-process Postgres (no external DB needed).
TEST_DATABASE_URL="postgres://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/agora_test?sslmode=require"

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-long-random-string"

# The apex domain tenants live under. Subdomains become tenant slugs
# (acme.agora.app -> tenant "acme"). Locally use localtest.me (resolves to
# 127.0.0.1) so acme.localtest.me works with no hosts-file editing.
# Also drives cross-subdomain cookie domain + CORS wildcard.
APP_DOMAIN="localtest.me:3000"

# This API's own publicly-reachable base URL — used ONLY to build the
# per-tenant customer-payment webhook URL revealed once at
# PUT /rpc/integrations/customer-payment (see tenant-customer-payments plan).
# Defaults to the local dev API port when unset.
# AGORA_API_PUBLIC_URL="https://api.example.com"

# Tenant → customer payments (agora/customer-payments): PER-TENANT ONLY. Each
# tenant configures its own PayMongo secret key + webhook secret at
# Settings -> Integrations -> Customer payments (tenant_integration category
# "customerPayment"). There is deliberately NO platform env fallback here —
# unlike email/storage, falling back would charge a tenant's customer into
# Agora's own PayMongo account. No new env var is introduced for this
# category itself.
#
# The member-facing surface built on top of this (member-credit-purchase
# plan): a member buys a credit pack or tops up their wallet online from
# {slug}.APP_DOMAIN/portal/credits via /portal/payments/{gateway,checkout,:id}
# (memberMiddleware()-gated); the tenant's own PayMongo webhook (the URL
# revealed once at PUT /rpc/integrations/customer-payment above) posts to
# POST /payments/customer/webhook/:token on THIS API, mounted outside /rpc.
# Fulfilment is webhook-only — the customer's browser landing back on
# /portal/credits never grants anything itself. See apps/chrono-api/AGENTS.md,
# "Unauthenticated routes", and docs/runbooks/customer-payment-webhook.md.

# Where the auth handler is mounted. MUST share the registrable domain with the
# tenant subdomains so the session cookie is shared — locally api.localtest.me.
BETTER_AUTH_URL="http://api.localtest.me:8787"

PORT=8787

# Web origins allowed to call the API (CORS). Any *.<APP_DOMAIN> subdomain is
# also allowed automatically.
WEB_ORIGIN="http://localtest.me:3000"

# ─── Transactional email ─────────────────────────────────────────
# Provider for outbound email (invites, password reset, verification).
#   console → logs the message + first action link to the API log (default;
#             lets you complete invite/reset flows locally with no provider).
#   resend  → POST to the Resend HTTP API (requires RESEND_API_KEY).
#   mailgun → POST to the Mailgun HTTP API (requires MAILGUN_API_KEY + MAILGUN_DOMAIN).
#   mailtrap → POST to Mailtrap's sandbox Testing API (requires MAILTRAP_API_TOKEN +
#              MAILTRAP_TEST_INBOX_ID). Dev/test-only — sandbox sends are captured for
#              inspection, never delivered. Used by chrono-web's e2e suite to verify a
#              real send/read round trip; see apps/chrono-web/e2e/utils/mailtrap-inbox.ts.
EMAIL_PROVIDER="console"
# Default From address; the tenant's brand name is prepended as the display
# name. Must be on a domain you've verified with your provider (e.g. Resend).
EMAIL_FROM="no-reply@example.com"
# Required only when EMAIL_PROVIDER=resend.
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# Required only when EMAIL_PROVIDER=mailgun.
# MAILGUN_API_KEY="key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# MAILGUN_DOMAIN="mg.yourdomain.com"
# Required only when EMAIL_PROVIDER=mailtrap (also read by the chrono-web e2e
# test runner to poll the sandbox inbox back).
# MAILTRAP_API_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# MAILTRAP_TEST_INBOX_ID="277668"
# Require staff to verify their email before signing in (Better Auth). Off by
# default so local/dev accounts aren't locked out; turn on once email delivers.
REQUIRE_EMAIL_VERIFICATION="false"
# NOTE for social sign-in: implicit account linking requires the LOCAL user row
# to be email-verified (accountLinking.requireLocalEmailVerified). With this off,
# an existing password user signing in with Google for the first time gets
# `account_not_linked` and is told to link from Settings -> Security instead.
# Turn this on if you want Google to link onto existing accounts automatically.

# The real inbox that receives IZUR's own apex `/support` and
# `/company/contact` lead-capture submissions (POST /public/company-inquiries,
# apex-support-page plan) via the active EMAIL_PROVIDER above. Required — the
# route refuses to report success while dropping a lead, so it 500s until this
# is set.
SUPPORT_INBOX_EMAIL="support@example.com"

# ─── Transactional SMS ────────────────────────────────────────────
# Provider for outbound SMS (background "sms" queue jobs only today — no
# built-in caller yet).
#   console → logs the recipient + body to the API log (default).
#   twilio  → POST to the Twilio Messages API (requires the three vars below).
SMS_PROVIDER="console"
# Required only when SMS_PROVIDER=twilio.
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_FROM_NUMBER="+15551234567"

# --- Platform security policy break-glass ------------------------
# Boot-time override that disables ALL platform-security-policy enforcement
# (the twoFactorRequired and sessionMaxAgeMinutes gates on /rpc-admin/* and
# /admin/*), checked once at process start like REQUIRE_EMAIL_VERIFICATION.
# This is NOT a remedy for a DB outage — the three allowlisted recovery
# routes (/rpc-admin/me, GET+PATCH /rpc-admin/security-policy,
# /rpc-admin/impersonation/stop) already bypass the enforcement read
# entirely and stay reachable during one. It exists for the narrower case of
# a defect in the enforcement/allowlist CODE itself that fails closed on a
# route that should have been exempt — the last-resort override when the
# code-level allowlist has a bug. See docs/runbooks/platform-security-lockout.md.
# PLATFORM_SECURITY_ENFORCEMENT_DISABLED="true"

# --- Platform System Settings break-glass ------------------------
# Boot-time override that disables ALL System-Settings enforcement — maintenance
# mode, global read-only mode, and disable-registrations (spec #14) — resolving
# every flag to its registry default (off) BEFORE the settings DB read. Unlike
# the security-policy resolver, settings enforcement already FAILS OPEN on a DB
# error, so this exists for the narrower case of a defect in the enforcement
# CODE itself that wrongly blocks tenant traffic. The /rpc-admin/* surface is a
# separate mount and is never gated, so admins can always turn the flags off
# from /admin/settings regardless.
# PLATFORM_SETTINGS_ENFORCEMENT_DISABLED="true"

# Per-actor ceiling on platform-admin mutating actions (per 60s). Production
# default is 20 and should stay there; this exists only so the offline e2e —
# which drives the whole platform-admin surface as ONE actor inside a single
# window — is not throttled by a DoS knob unrelated to what it asserts.
# PLATFORM_ADMIN_MUTATE_MAX="20"

# Real usage metering (platform-usage-limits, spec #8). When "true", each tenant
# `/rpc/*` request increments that tenant's `api_requests` counter for the
# current month bucket (best-effort, fire-and-forget — never blocks or fails a
# request). OFF by default so no hot-path DB write is forced on a deployment
# that doesn't want per-request metering. Surfaced at /admin/usage (per-org
# history). Storage/bandwidth/DB/devices metering is deliberately NOT built —
# no ingestion surface for them exists in this scaffold.
# USAGE_METERING_ENABLED="true"

# --- Social sign-in (staff pool) ---------------------------------
# OPTIONAL. A provider is registered only when BOTH of its values are present;
# without them the platform admin portal shows it as "credentials not configured"
# and it can never be enabled. Whether a configured provider is actually offered
# is a separate platform-admin switch (APP_DOMAIN/admin/auth-providers).
#
# The OAuth redirect URI is the API origin, NOT the web origin:
#   http://api.localtest.me:8787/api/auth/callback/google
#   http://api.localtest.me:8787/api/auth/callback/facebook
#
# The member portal's own social login (member-portal-social-login plan)
# reuses these same credentials via a second, fixed set of callback URIs —
# register these too in the Google Cloud Console OAuth client and the
# Facebook App dashboard:
#   http://api.localtest.me:8787/portal/auth/google/callback
#   http://api.localtest.me:8787/portal/auth/facebook/callback
#
# The global customer portal's social login (global-portal-social-login plan)
# also reuses these same credentials via a third, fixed set of callback URIs —
# register these too in the Google Cloud Console OAuth client and the
# Facebook App dashboard:
#   http://api.localtest.me:8787/auth/customer/google/callback
#   http://api.localtest.me:8787/auth/customer/facebook/callback
# GOOGLE_AUTH_KEY="xxxxxxxx.apps.googleusercontent.com"
# GOOGLE_AUTH_SECRET="xxxxxxxx"
# FACEBOOK_AUTH_KEY="xxxxxxxx"
# FACEBOOK_AUTH_SECRET="xxxxxxxx"

# ─── Outbound webhooks ───────────────────────────────────────────
# Tenant-registered endpoints receive signed, retried POSTs on domain events.
# All values below are OPTIONAL and have safe production defaults.
# Delivery worker tuning:
#   WEBHOOK_MAX_ATTEMPTS      tries before a delivery is marked failed (default 6)
#   WEBHOOK_DISABLE_THRESHOLD consecutive endpoint failures before auto-disable (5)
#   WEBHOOK_BATCH_SIZE        due rows drained per tick (default 20)
#   WEBHOOK_TIMEOUT_MS        per-request timeout (default 10000)
#   WEBHOOK_BACKOFF_BASE_MS   retry backoff base, doubled per attempt (default 30000)
#   WEBHOOK_BACKOFF_MAX_MS    retry backoff cap (default 3600000)
#   WEBHOOK_POLL_MS           worker poll interval (default 5000)
# WEBHOOK_MAX_ATTEMPTS="6"
#
# ⚠ SSRF: WEBHOOK_INSECURE_HOSTS is a comma-separated allowlist of hostnames/IPs
# that skip the https + private-range checks. It exists ONLY for local dev/tests
# (e.g. "127.0.0.1"). NEVER set it in production — leaving it empty keeps webhook
# targets restricted to public https destinations.
# WEBHOOK_INSECURE_HOSTS=""
# ─── Custom domains (verification + TLS provisioning) ────────────
# Provider that registers a VERIFIED custom host at the edge so a TLS cert is
# issued and traffic routes:
#   noop   → no external calls (default; local/dev/test).
#   vercel → add/remove the domain on a Vercel project (auto-provisions TLS).
DOMAIN_PROVIDER="noop"
# Required only when DOMAIN_PROVIDER=vercel. Create a token at
# vercel.com/account/tokens; PROJECT_ID is on the project's Settings page.
# VERCEL_TOKEN="xxxxxxxxxxxxxxxxxxxx"
# VERCEL_PROJECT_ID="prj_xxxxxxxxxxxxxxxxxxxx"
# Only for team-scoped projects.
# VERCEL_TEAM_ID="team_xxxxxxxxxxxxxxxxxxxx"
# CNAME target shown to admins who verify by CNAME. Defaults to cname.<APP_DOMAIN>.
# On Vercel this is typically "cname.vercel-dns.com".
# DOMAIN_CNAME_TARGET="cname.vercel-dns.com"
# Shared secret protecting POST /internal/domains/recheck (the periodic
# re-verification job). Send it as the `x-internal-token` header from your
# scheduler/cron. Leave unset to disable the endpoint (returns 401).
# INTERNAL_JOB_TOKEN="replace-me-with-a-long-random-string"
# ─── Billing (platform PSP: Stripe, Xendit, or PayMongo) ─────────
# Billing is OPTIONAL and OFF by default. With no configured secret key the app
# runs fine: every tenant is on the implicit "free" plan, checkout/portal return
# a clear "not configured" error, and entitlements/seat caps still apply.
# Set BILLING_ENABLED="false" to force-disable even when a key is present.
# BILLING_ENABLED="true"
# Select the platform payment provider (ONE PSP for all tenants — an operator
# choice, not per-tenant). Defaults to "stripe"; if unset it is inferred from
# whichever secret key is configured. Values: stripe | xendit | paymongo.
# BILLING_PROVIDER="stripe"
#
# The checkout AMOUNT for each paid plan is read live from the platform-admin
# plan catalog (`/admin/plans`'s per-currency prices, see
# .ai/plans/agora/archive/unified-billing-price-source/README.md) — NOT from an env
# var. A currency with no matching plan_price row fails checkout with a clear
# 409 rather than falling back to anything env-configured (see
# .ai/plans/agora/in-progress/remove-billing-env-price-fallback/README.md).
#
# ── Stripe ──
# STRIPE_SECRET_KEY="sk_test_xxx"
# Signing secret for the /billing/webhook endpoint (Stripe CLI or dashboard).
# STRIPE_WEBHOOK_SECRET="whsec_xxx"
# STABLE Stripe Product ids (Products → not Prices — the price itself is now
# built ad-hoc from the admin-set amount; only the Product needs to exist and
# stay the same across every checkout, so Stripe's own product-grouped
# reporting doesn't fragment). Create one Product per paid plan once.
# STRIPE_PRODUCT_PRO="prod_xxx"
# STRIPE_PRODUCT_ENTERPRISE="prod_xxx"
#
# ── Xendit (BILLING_PROVIDER="xendit") ──
# Checkout uses a hosted Xendit Invoice. NOTE: Xendit has NO hosted billing
# portal, so "Manage billing" degrades gracefully (the API returns 501).
# Xendit's actual supported-currency set is NOT empirically confirmed (no
# test credentials were available when this was wired up) — treated
# conservatively as idr/php only; confirm against Xendit's API reference
# before relying on this for a currency outside those two.
# XENDIT_SECRET_KEY="xnd_development_xxx"
# Callback verification token — compared (constant-time) to the inbound
# x-callback-token header on /billing/webhook.
# XENDIT_WEBHOOK_TOKEN="replace-me-with-your-xendit-callback-token"
#
# ── PayMongo (BILLING_PROVIDER="paymongo") ──
# Checkout uses a hosted PayMongo Checkout Session. PayMongo settles in PHP
# ONLY (confirmed live) and has NO subscription object and NO hosted billing
# portal — each billing period is a fresh checkout, not an auto-renewal;
# "Manage billing" degrades gracefully (the API returns 501), same as Xendit.
# PAYMONGO_SECRET_KEY="sk_test_xxx"
# Signing secret shown when you register a webhook endpoint in the PayMongo
# dashboard (Developers → Webhooks) — verifies the `paymongo-signature` header.
# PAYMONGO_WEBHOOK_SECRET="whsk_xxx"
#
# ── Platform customer-payment fallback (shared PayMongo account) ──
# Separate from PAYMONGO_SECRET_KEY above: that key is Agora's OWN billing
# revenue (platform -> tenant). These two back a SECOND PayMongo account used
# only when a tenant hasn't configured its own customer-payment integration
# (tenant's customer -> platform, held on the tenant's behalf until payout).
# Env-only for v1, no admin-editable secret row. Unset = no fallback offered.
# PLATFORM_CUSTOMER_PAYMENT_PAYMONGO_SECRET_KEY="sk_test_xxx"
# PLATFORM_CUSTOMER_PAYMENT_PAYMONGO_WEBHOOK_SECRET="whsk_xxx"
# ─── Staff SSO + MFA / integration secrets ───────────────────────
# 32-byte key (base64) used to encrypt secrets at rest (AES-256-GCM): tenant SSO
# client secrets AND per-tenant integration secrets (email API key, storage
# secret access key). Required to save any of those. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SSO_ENC_KEY="replace-me-with-a-32-byte-base64-key"
# ─── Object storage (branding asset uploads + the tenant `file` resource) ─
# Platform storage provider, the fallback used when a tenant has NOT connected its
# own bucket (Settings → Integrations → Storage; per-tenant creds are stored
# encrypted in the DB, never here):
#   local      (default) → write under STORAGE_LOCAL_DIR, served at
#                           ${STORAGE_PUBLIC_BASE_URL}/uploads/<key>; the
#                           pre-signed upload/download flow proxies through
#                           /api/upload/local + /api/download/local (dev
#                           fallback only — plain, not cryptographically
#                           signed; never used when STORAGE_PROVIDER=s3/cloudinary).
#   s3         → an S3-compatible bucket (AWS S3 / R2 / MinIO / B2), signed
#                with SigV4 over fetch (no SDK).
#   cloudinary → Cloudinary, signed with node:crypto (no SDK). Credentials are
#                env-only (never per-tenant) — surfaced at /admin/integrations
#                as hasCredentials, never the value.
# STORAGE_PROVIDER="local"
# STORAGE_LOCAL_DIR=".uploads"
# STORAGE_PUBLIC_BASE_URL="http://localhost:8787"
# Required only when STORAGE_PROVIDER=s3:
# STORAGE_S3_REGION="us-east-1"
# STORAGE_S3_BUCKET="my-bucket"
# STORAGE_S3_ACCESS_KEY_ID="AKIA..."
# STORAGE_S3_SECRET_ACCESS_KEY="xxxxxxxx"
# Optional: custom endpoint (R2/MinIO/B2 → path-style) + public base URL / CDN.
# STORAGE_S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# STORAGE_S3_PUBLIC_BASE_URL="https://cdn.example.com"
# Required only when STORAGE_PROVIDER=cloudinary:
# CLOUDINARY_CLOUD_NAME="my-cloud"
# CLOUDINARY_API_KEY="123456789012345"
# CLOUDINARY_API_SECRET="xxxxxxxx"
# Optional, provider-agnostic (local/s3/cloudinary alike): base folder every
# tenant's files are nested under when that tenant has NOT set its own upload
# folder (Settings → Integrations → Storage → Upload folder overrides this).
# Unset → files go straight under the tenant id at the root, no extra prefix.
# STORAGE_FOLDER="agora"

# ─── Observability (optional error tracking + tracing) ───────────
# Error tracking (Sentry). Unset → fully inert (no-op), matching every other
# optional provider in this scaffold. Install is already in package.json;
# this only activates it.
# SENTRY_DSN="https://xxxx@oNNNNNN.ingest.us.sentry.io/NNNNNNN"
# SENTRY_ENVIRONMENT="development"
# SENTRY_RELEASE=""
# OpenTelemetry tracing (HTTP + pg auto-instrumentation), OTLP exporter.
# Requires @opentelemetry/sdk-node + @opentelemetry/auto-instrumentations-node
# (NOT installed by this plan — tracing is a separate, later phase; document only).
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
